+                >
+                  تواصل
+                </Link>
+              </div>
+            ) : (
+              <span className="text-[11px] text-[#999]">العرض مرئي لصاحب المشروع فقط بالتفصيل</span>
+            )}
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+}
