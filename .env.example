# ============================================================
# mnste9 — نموذج متغيرات البيئة
# انسخه إلى .env واملأ القيم الحقيقية:  cp .env.example .env
# لا تضع أبداً قيماً حقيقية في هذا الملف — فهو متتبَّع في Git
# ============================================================

# قاعدة البيانات (PostgreSQL على Neon)
# من لوحة Neon: Project → Connection string → Pooled connection
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler-REGION.aws.neon.tech/neondb?sslmode=require

# التطبيق
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# الأمان — قيم فارغة عمداً؛ ولِّدها محلياً ولا تشاركها:
#   NEXTAUTH_SECRET (32 بايت):   openssl rand -base64 32
NEXTAUTH_SECRET=
#   KYC_ENCRYPTION_KEY (32 بايت بصيغة hex = 64 حرفاً — مفتاح AES-256):
#   openssl rand -hex 32
KYC_ENCRYPTION_KEY=
