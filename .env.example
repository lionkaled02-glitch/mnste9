# ============================================================================
#  mnste9 — نموذج متغيرات البيئة
#  انسخ هذا الملف إلى .env واملأ القيم الحقيقية:
#
#  على Linux/Mac:  cp .env.example .env
#  على Windows:    copy .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# قاعدة البيانات (Neon PostgreSQL)
# ----------------------------------------------------------------------------
# احصل على الرابط من: https://console.neon.tech
#   Dashboard → Project → Connection string → "Pooled connection"
#
# الصيغة:
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------------------------
# الجلسات والمصادقة
# ----------------------------------------------------------------------------
# مفتاح سري لتوقيع JWT (32 بايت على الأقل)
# ولّده عبر:  openssl rand -base64 32
#
NEXTAUTH_SECRET=your_nextauth_secret_here

# ----------------------------------------------------------------------------
# رابط التطبيق
# ----------------------------------------------------------------------------
# في التطوير: http://localhost:3000
# في الإنتاج: https://mnste9.com
#
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# تشفير وثائق KYC (AES-256-GCM)
# ----------------------------------------------------------------------------
# مفتاح تشفير 32 بايت (64 حرف hex)
# ولّده عبر:  openssl rand -hex 32
#
KYC_ENCRYPTION_KEY=your_kyc_encryption_key_here

# ----------------------------------------------------------------------------
# بيئة التشغيل
# ----------------------------------------------------------------------------
# development | production | test
#
NODE_ENV=development

# ----------------------------------------------------------------------------
# بوابات الدفع (للمرحلة القادمة)
# ----------------------------------------------------------------------------
# PayPal (Sandbox في التطوير)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# بنك الكريمي (بيانات التاجر)
KURAIMI_MERCHANT_ID=
KURAIMI_API_KEY=
KURAIMI_API_URL=